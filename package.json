{
  "name": "typescript-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/typescript-sdk",
    "packages/typescript-sdk-cli"
  ],
  "scripts": {
    "check": "prettier --check .",
    "format": "prettier --write .",
