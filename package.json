    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.5.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
