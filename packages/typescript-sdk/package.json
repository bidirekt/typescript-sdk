{
  "name": "@bidirekt/typescript-sdk",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidirekt/typescript-sdk.git",
    "directory": "packages/typescript-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "node -e \"for (const file of ['README.md', 'LICENSE']) fs.copyFileSync('../../' + file, file)\"",
    "prepublishOnly": "npm run build"
  }
}
