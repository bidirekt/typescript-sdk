extend schema @link(url: "https://specs.apollo.dev/federation/v2.3", import: ["@key"])

type Query {
  pet(id: ID!): Pet
  owner(id: ID!): Owner
}

type Pet @key(fields: "id") {
  id: ID!
  name: String!
  reviews: [Review!]!
}

type Owner @key(fields: "id") {
  id: ID!
  name: String!
}

type Review {
  stars: Int!
}
